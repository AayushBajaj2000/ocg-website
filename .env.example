# Resend — https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# Must be on a Resend-verified domain
CONTACT_FROM_EMAIL=OpenCore Group <hello@opencoregroup.com>
# Inbox that receives submissions (env, not hardcoded, so staging can redirect)
CONTACT_NOTIFICATION_EMAIL=info@opencoregroup.com

# Cloudflare Turnstile — https://dash.cloudflare.com → Turnstile
# Defaults below are Cloudflare's always-pass TEST pair: a fresh clone runs with no setup.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Absolute origin for images/links inside emails (no trailing slash). Server-only: emails render
# on the server, so this stays out of the client bundle.
SITE_URL=https://www.opencoregroup.com

# Sanity — read-only access to the official OpenCore Group content lake (blog posts).
# Server-only: the dataset rejects browser origins (CORS), so all queries run on the server.
SANITY_PROJECT_ID=4x3yyhbh
SANITY_DATASET=production
SANITY_API_VERSION=2025-02-19
