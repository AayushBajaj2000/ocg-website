# Resend — https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# Must be on a Resend-verified domain
CONTACT_FROM_EMAIL=OpenCore Group <hello@opencoregroup.com>
# Inbox that receives submissions (env, not hardcoded, so staging can redirect)
CONTACT_NOTIFICATION_EMAIL=info@opencoregroup.com

# Cloudflare Turnstile — https://dash.cloudflare.com → Turnstile
# Defaults below are Cloudflare's always-pass TEST pair: a fresh clone runs with no setup.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Absolute origin for images/links inside emails (no trailing slash). Server-only: emails render
# on the server, so this stays out of the client bundle.
SITE_URL=https://www.opencoregroup.com

# Sanity — read-only access to the official OpenCore Group content lake (blog posts).
# Server-only: the dataset rejects browser origins (CORS), so all queries run on the server.
SANITY_PROJECT_ID=4x3yyhbh
SANITY_DATASET=production
SANITY_API_VERSION=2025-02-19

# Website AI assistant (the floating "Ask AI" button) — an eve agent in agent/, served at /eve/v1.
# The model runs through the Vercel AI Gateway: https://vercel.com/dashboard → AI Gateway → API keys.
# Local dev only. On Vercel the deployment authenticates with project OIDC, so no key is needed.
# Set a budget on the gateway: this endpoint is public.
AI_GATEWAY_API_KEY=
# Optional model override (any AI Gateway "provider/model" id).
# ASSISTANT_MODEL=google/gemini-2.5-flash-lite
# Optional: where the assistant reads its knowledge from. Defaults to SITE_URL + /llms.txt.
# Point it at http://localhost:3000/llms.txt to test local content changes.
# ASSISTANT_KNOWLEDGE_URL=
